    Label.Font = Enum.Font.Gotham
    Label.TextSize = 16
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = B

    local Track = Instance.new("Frame")
    Track.Size = UDim2.new(0, 70, 0, 34)
    Track.Position = UDim2.new(1, -82, .5, -17)
    Track.BackgroundColor3 = Color3.fromRGB(32, 52, 82)
    Track.BorderSizePixel = 0
    Track.Parent = B
    Corner(Track, 17)

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 25, 0, 25)
    Knob.Position = UDim2.new(0, 5, 0, 4)
    Knob.BackgroundColor3 = Color3.fromRGB(235, 238, 243)
    Knob.BorderSizePixel = 0
    Knob.Parent = Track
    Corner(Knob, 13)

    local State = Default == true

    local function Render()
        if State then
            Tween(Track, { BackgroundColor3 = Theme.Accent }):Play()
            Tween(Knob, { Position = UDim2.new(0, 40, 0, 4) }):Play()
        else
            Tween(Track, { BackgroundColor3 = Color3.fromRGB(32, 52, 82) }):Play()
            Tween(Knob, { Position = UDim2.new(0, 5, 0, 4) }):Play()
        end
    end
    Render()

    B.MouseButton1Click:Connect(function()
        State = not State
        Render()
        if Callback then Callback(State) end
    end)

    return B
end

