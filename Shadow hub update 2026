        local antiBanConnections = {}

        local function StartAntiBan()
            if antiBanActive then return end
            antiBanActive = true

            Notify("Anti-Ban", "Ativado!")

            -- Bloqueia queda
            local function BlockFall()
                local char = LocalPlayer.Character
                if not char then return end
                local root = char:FindFirstChild("HumanoidRootPart")
                if not root then return end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not hum then return end

                if root.AssemblyLinearVelocity.Y < -20 then
                    root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
                end

                pcall(function()
                    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                end)
            end

            local conn = RunService.Heartbeat:Connect(BlockFall)
            table.insert(antiBanConnections, conn)

            -- Anti-AFK
            local afkTimer = 0
            local afkConn = RunService.Heartbeat:Connect(function()
                afkTimer = afkTimer + 1
                if afkTimer >= 180 then
                    afkTimer = 0
                    task.spawn(function()
                        local mouse = LocalPlayer:GetMouse()
                        if mouse then
                            mouse.Move(Vector2.new(mouse.X + 1, mouse.Y))
                            task.wait(0.05)
                            mouse.Move(Vector2.new(mouse.X - 1, mouse.Y))
                        end
                    end)
                end
            end)
            table.insert(antiBanConnections, afkConn)
        end

        local function StopAntiBan()
            if not antiBanActive then return end
            antiBanActive = false

            for _, conn in ipairs(antiBanConnections) do
                pcall(function() conn:Disconnect() end)
            end
            antiBanConnections = {}

            Notify("Anti-Ban", "Desativado!")
