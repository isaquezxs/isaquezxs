-- ============================================================
-- VARIÁVEIS DA CALCULADORA
-- ============================================================

local currentNumber = ""
local previousNumber = ""
local operation = ""
local resultDisplayed = false
local isNewNumber = true

-- ============================================================
-- FUNÇÃO PARA ATUALIZAR O DISPLAY
-- ============================================================

local function UpdateDisplay(value)
    if value == "" or value == nil then
        display.Text = "0"
    else
        -- Formata o número para evitar muitos decimais
        local num = tonumber(value)
        if num then
            if num % 1 == 0 then
                display.Text = tostring(num)
            else
                display.Text = string.format("%.8f", num):gsub("0+$", ""):gsub("%.$", "")
            end
        else
            display.Text = value
        end
    end
end

-- ============================================================
-- FUNÇÃO PARA ADICIONAR NÚMERO
-- ============================================================

local function AddNumber(number)
    if resultDisplayed then
        currentNumber = ""
        resultDisplayed = false
    end
    
    if isNewNumber then
        currentNumber = ""
        isNewNumber = false
    end
    
    -- Limita o tamanho do número
    if string.len(currentNumber) >= 15 then return end
    
    currentNumber = currentNumber .. tostring(number)
    UpdateDisplay(currentNumber)
end

-- ============================================================
-- FUNÇÃO PARA ADICIONAR PONTO DECIMAL
-- ============================================================

local function AddDecimal()
    if resultDisplayed then
        currentNumber = "0"
        resultDisplayed = false
        isNewNumber = false
    end
    
    if isNewNumber then
        currentNumber = "0"
        isNewNumber = false
    end
    
    if not string.find(currentNumber, "%.") then
        if currentNumber == "" then
            currentNumber = "0."
        else
            currentNumber = currentNumber .. "."
        end
        UpdateDisplay(currentNumber)
    end
end

-- ============================================================
-- FUNÇÃO PARA ADICIONAR OPERADOR
-- ============================================================

local function AddOperator(op)
    if currentNumber == "" and previousNumber == "" then
        return
    end
    
    if currentNumber == "" and previousNumber ~= "" then
        operation = op
        return
    end
    
    if previousNumber ~= "" and currentNumber ~= "" then
        Calculate()
    end
    
    previousNumber = currentNumber
    currentNumber = ""
    operation = op
    isNewNumber = true
    resultDisplayed = false
end

-- ============================================================
-- FUNÇÃO PARA CALCULAR
-- ============================================================

local function Calculate()
    if previousNumber == "" or currentNumber == "" or operation == "" then
        return
    end
    
    local num1 = tonumber(previousNumber)
    local num2 = tonumber(currentNumber)
    
    if num1 == nil or num2 == nil then
        return
    end
    
    local result = 0
    
    if operation == "+" then
        result = num1 + num2
    elseif operation == "-" then
        result = num1 - num2
    elseif operation == "×" then
        result = num1 * num2
    elseif operation == "÷" then
        if num2 == 0 then
            display.Text = "Erro: Div/0"
            previousNumber = ""
            currentNumber = ""
            operation = ""
            isNewNumber = true
            resultDisplayed = true
            return
        end
        result = num1 / num2
    end
    
    -- Verifica se o resultado é inteiro
    if result % 1 == 0 then
        display.Text = tostring(result)
    else
        display.Text = string.format("%.8f", result):gsub("0+$", ""):gsub("%.$", "")
    end
    
    currentNumber = tostring(result)
    previousNumber = ""
    operation = ""
    isNewNumber = true
    resultDisplayed = true
end

-- ============================================================
-- FUNÇÃO PARA LIMPAR
-- ============================================================

local function Clear()
    currentNumber = ""
    previousNumber = ""
    operation = ""
    isNewNumber = true
    resultDisplayed = false
    display.Text = "0"
end

-- ============================================================
-- FUNÇÃO PARA BACKSPACE
-- ============================================================

local function Backspace()
    if resultDisplayed then
        Clear()
        return
    end
    
    if currentNumber ~= "" then
        currentNumber = currentNumber:sub(1, -2)
        if currentNumber == "" then
            display.Text = "0"
        else
            UpdateDisplay(currentNumber)
        end
    end
end

-- ============================================================
-- FUNÇÃO PARA CRIAR BOTÕES
-- ============================================================

local function CreateButton(parent, text, yPos, xPos, width, height, callback, color)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(width or 0.22, 0, height or 0, 50)
    btn.Position = UDim2.new(xPos or 0.02, 0, 0, yPos)
    btn.BackgroundColor3 = color or Color3.fromRGB(50, 50, 80)
    btn.BackgroundTransparency = 0.3
    btn.BorderSizePixel = 0
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    btn.Font = Enum.Font.GothamBold
    btn.Parent = parent

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn

    btn.MouseEnter:Connect(function()
        btn.BackgroundTransparency = 0.1
    end)
    btn.MouseLeave:Connect(function()
        btn.BackgroundTransparency = 0.3
    end)

    btn.MouseButton1Click:Connect(callback)
    return btn
end

