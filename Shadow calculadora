-- Drag do botão flutuante
local dragging = false
local dragInput
local dragStart
local startPos
local UserInputService = game:GetService("UserInputService")

openBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = openBtn.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

openBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        openBtn.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- Abrir/Fechar calculadora
local calcVisible = true

openBtn.MouseButton1Click:Connect(function()
    calcVisible = not calcVisible
    mainFrame.Visible = calcVisible
end)

-- ============================================================
-- TECLAS DE ATALHO DO TECLADO
-- ============================================================

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    local key = input.KeyCode
    
    if key == Enum.KeyCode.One then AddNumber(1)
    elseif key == Enum.KeyCode.Two then AddNumber(2)
    elseif key == Enum.KeyCode.Three then AddNumber(3)
    elseif key == Enum.KeyCode.Four then AddNumber(4)
    elseif key == Enum.KeyCode.Five then AddNumber(5)
    elseif key == Enum.KeyCode.Six then AddNumber(6)
    elseif key == Enum.KeyCode.Seven then AddNumber(7)
    elseif key == Enum.KeyCode.Eight then AddNumber(8)
    elseif key == Enum.KeyCode.Nine then AddNumber(9)
    elseif key == Enum.KeyCode.Zero then AddNumber(0)
    elseif key == Enum.KeyCode.Period then AddDecimal()
    elseif key == Enum.KeyCode.Plus then AddOperator("+")
    elseif key == Enum.KeyCode.Minus then AddOperator("-")
    elseif key == Enum.KeyCode.KeypadMultiply then AddOperator("×")
    elseif key == Enum.KeyCode.KeypadDivide then AddOperator("÷")
    elseif key == Enum.KeyCode.Equals or key == Enum.KeyCode.KeypadEnter then Calculate()
    elseif key == Enum.KeyCode.Backspace then Backspace()
    elseif key == Enum.KeyCode.Delete or key == Enum.KeyCode.C then Clear()
    elseif key == Enum.KeyCode.KeypadMinus then AddOperator("-")
    elseif key == Enum.KeyCode.KeypadPlus then AddOperator("+")
    end
end)

