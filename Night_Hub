-- FUNÇÕES DE EMOTE
-- ==========================================
local function PlayCloneEmote(animId, emoji)
    if not CloneAnimator then return end
    for _, track in ipairs(CloneAnimator:GetPlayingAnimationTracks()) do
        track:Stop(0.1)
    end
    isPlayingEmote = true
    CloneParado = true
    CloneAndandoAleatorio = false
    local anim = Instance.new("Animation")
    anim.AnimationId = animId
    CurrentEmote = CloneAnimator:LoadAnimation(anim)
    CurrentEmote.Priority = Enum.AnimationPriority.Action4
    CurrentEmote.Looped = true
    CurrentEmote:Play(0.1)
    if CloneChatText and emoji then CloneChatText.Text = emoji end
    UltimaMensagemIA = emoji
end

local function StopEmote()
    if CurrentEmote then CurrentEmote:Stop() CurrentEmote = nil end
    isPlayingEmote = false
    CloneParado = false
    CloneAndandoAleatorio = false
    if CloneHumanoid then CloneHumanoid.Sit = false end
end

local function criarBotaoH(texto, posY, cor, action, animId, isSit, emoji)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 35) 
    btn.Position = UDim2.new(0.05, 0, 0, 40 + (posY * 38)) 
    btn.BackgroundColor3 = cor
    btn.Text = texto
    btn.TextColor3 = Color3.fromRGB(0, 0, 0)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.ZIndex = 51
    btn.Parent = PersonalityMenu
    addCorner(btn, 8)
    
    local function ExecutarAcao()
        if action == "stop_all" then
            StopEmote()
            if CloneHumanoid then CloneHumanoid.Sit = false end
            CloneParado = false
            CloneAndandoAleatorio = false
            if CloneChatText then CloneChatText.Text = "😎 Olá! Sou " .. CloneName .. "." end
            UltimaMensagemIA = "😎 Olá! Sou " .. CloneName .. "."
            
        elseif action == "jump" then
            if CloneHumanoid then 
                CloneHumanoid:ChangeState(Enum.HumanoidStateType.Jumping) 
                if CloneChatText then CloneChatText.Text = "🦘 Pulando!" end
                UltimaMensagemIA = "🦘"
            end
            
        elseif action == "random_walk" then
            StopEmote()
            CloneParado = false
            CloneAndandoAleatorio = true
            if CloneChatText then CloneChatText.Text = "🚶 Andando por aí..." end
            UltimaMensagemIA = "🚶"
            
        elseif action == "stop_follow" then
            StopEmote()
            CloneParado = true
            CloneAndandoAleatorio = false
            if CloneChatText then CloneChatText.Text = "🛑 Parado." end
            UltimaMensagemIA = "🛑"
            
        elseif action == "follow" then
            StopEmote()
            CloneParado = false
            CloneAndandoAleatorio = false
            if CloneChatText then CloneChatText.Text = "🏃 Seguindo." end
            UltimaMensagemIA = "🏃"
            
        elseif isSit then
            StopEmote()
            CloneParado = true
            if CloneHumanoid then CloneHumanoid.Sit = true end
            if CloneChatText then CloneChatText.Text = emoji end
            UltimaMensagemIA = emoji
            
        else
            if CloneHumanoid then CloneHumanoid.Sit = false end
            PlayCloneEmote(animId, emoji)
        end
    end

    btn.MouseButton1Click:Connect(ExecutarAcao)
    btn.TouchTap:Connect(ExecutarAcao)
end

