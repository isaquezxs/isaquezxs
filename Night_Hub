UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if ChatInput:IsFocused() then return end

    if input.KeyCode == Enum.KeyCode.F then
        if not LoginWindow.Visible then
            ChatWindow.Visible = not ChatWindow.Visible
        end
    elseif input.KeyCode == Enum.KeyCode.M then
        if CloneObj and CloneObj.Parent then
            if isCarrying then return end
            CarryMenu.Visible = not CarryMenu.Visible
        end
    elseif input.KeyCode == Enum.KeyCode.N then
        if isCarrying then
            soltarClone()
            if CarryBtn then CarryBtn.Text = "Pegar Clone" end
        end
