local isThinking = false
local function GetRequestFunction()
    return (syn and syn.request) or (http and http.request) or http_request or request
end

local function ProcessCommand(message)
    local cmd = string.lower(string.gsub(message, "[^%a%s]", "")):gsub("^%s*(.-)%s*$", "%1")
    
    if cmd == "choro" or cmd == "chorar" then
        PlayCloneEmote("rbxassetid://507770239", "😭")
        AddMessage("Comando: Chorando.", true)
        return true
    elseif cmd == "feliz" or cmd == "comemorar" then
        PlayCloneEmote("rbxassetid://507770677", "😊")
        AddMessage("Comando: Feliz!", true)
        return true
    elseif cmd == "gato" or cmd == "imitargato" then
        PlayCloneEmote("rbxassetid://507771019", "🐱")
        AddMessage("Comando: Imitando gato.", true)
        return true
    elseif cmd == "cachorro" or cmd == "imitarcachorro" then
        PlayCloneEmote("rbxassetid://5918726674", "🐶")
        AddMessage("Comando: Imitando cachorro.", true)
        return true
    elseif cmd == "sentar" or cmd == "senta" then
        StopEmote()
        CloneParado = true
        PlayCloneEmote("rbxassetid://2506281703", "🪑")
        AddMessage("Comando: Sentando.", true)
        return true
    elseif cmd == "parar" or cmd == "normal" then
        StopEmote()
        if CloneChatText then CloneChatText.Text = "😎 Olá! Sou " .. CloneName .. "." end
        UltimaMensagemIA = "😎 Olá! Sou " .. CloneName .. "."
        AddMessage("Comando: Voltando ao normal.", true)
        return true
    elseif cmd == "pula" or cmd == "pular" then
        if CloneHumanoid then CloneHumanoid:ChangeState(Enum.HumanoidStateType.Jumping) end
        AddMessage("Comando: Pulando!", true)
        return true
    end
    
    return false
end

local function AskAI(message)
    if isThinking then return end
    if ProcessCommand(message) then
        ChatInput.Text = ""
        return 
    end

    AddMessage(message, true)
    ChatInput.Text = ""
    if CloneChatText then CloneChatText.Text = "🤖 Pensando..." end
    UltimaMensagemIA = "🤖 Pensando..."
    
    if API_KEY == "" or #API_KEY < 10 then
        AddMessage("Erro: Coloque uma API KEY válida!", false)
        return
    end
    
    local requestFunc = GetRequestFunction()
    if not requestFunc then AddMessage("Executor sem request.", false) return end
    
    isThinking = true
    SendBtn.Text = "..."
    
    local mensagensParaEnviar = {
        { role = "system", content = "Você é um clone amigável no Roblox chamado " .. CloneName .. ". Responda de forma curta, completa, clara e em português." }
    }
    
    for _, msgHist in ipairs(historicoConversa) do
        table.insert(mensagensParaEnviar, msgHist)
    end
    
    local data = {
        model = MODELO,
        messages = mensagensParaEnviar,
        max_tokens = 300,
        temperature = 0.7
    }
    local body = HttpService:JSONEncode(data)
    
    task.spawn(function()
        local success, response = pcall(function()
            return requestFunc({
                Url = "https://api.groq.com/openai/v1/chat/completions",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. API_KEY },
                Body = body
            })
        end)
        isThinking = false
        SendBtn.Text = "Enviar"
        if success and response and response.StatusCode == 200 then
            local decoded = HttpService:JSONDecode(response.Body)
            local reply = decoded.choices[1].message.content
            reply = reply:gsub("\n", " "):gsub("^%s*(.-)%s*$", "%1")
            
            if #reply > 3000 then reply = reply:sub(1, 3000) .. "..." end
            
            AddMessage(reply, false)
            if CloneChatText then CloneChatText.Text = "💬 " .. reply end
            UltimaMensagemIA = reply
        else
            AddMessage("Erro da API: Verifique sua chave ou internet.", false)
        end
    end)
end

