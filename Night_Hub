local function AddMessage(text, isUser)
    local msg = Instance.new("TextLabel")
    msg.Size = UDim2.new(1, -10, 0, 50)
    msg.AutomaticSize = Enum.AutomaticSize.Y
    msg.BackgroundColor3 = isUser and Color3.fromRGB(40, 40, 60) or Colors.Panel
    msg.TextColor3 = isUser and Colors.Text or Colors.Accent
    msg.Font = Enum.Font.Gotham
    msg.TextSize = 12
    msg.TextWrapped = true
    msg.Text = (isUser and "Você: " or CloneName .. ": ") .. text
    msg.Parent = ChatScroll
    addCorner(msg, 6)
    
    LogSalvo = LogSalvo .. (isUser and "Você: " or CloneName .. ": ") .. text .. "\n"

    if isUser then
        table.insert(historicoConversa, {role = "user", content = text})
    else
        table.insert(historicoConversa, {role = "assistant", content = text})
    end
    
    if #historicoConversa > 10 then
        table.remove(historicoConversa, 1)
    end
end

