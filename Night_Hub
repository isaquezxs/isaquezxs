local function AddMessage(text, isUser)
    local msg = Instance.new("TextLabel")
    -- Ajusta a altura do painel baseado no tamanho do texto
    msg.Size = UDim2.new(1, -10, 0, isUser and 30 or 60) 
    msg.BackgroundColor3 = isUser and Color3.fromRGB(40, 40, 60) or Colors.Panel
    msg.TextColor3 = isUser and Colors.Text or Colors.Accent
    msg.Font = Enum.Font.Gotham
    msg.TextSize = 12
    msg.TextWrapped = true
    msg.Text = (isUser and "Você: " or "IA: ") .. text
    msg.Parent = ChatScroll
    addCorner(msg, 6)
    
    ChatLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        ChatScroll.CanvasSize = UDim2.new(0, 0, 0, ChatLayout.AbsoluteContentSize.Y + 10)
    end)
end

-- ==========================================
-- SISTEMA DO CLONE
-- ==========================================
local CloneObj, CloneHumanoid, CloneRoot, CloneChatText, AI_Connection = nil, nil, nil, nil, nil

local function RemoveClone()
    if CloneObj then CloneObj:Destroy(); CloneObj = nil end
    if AI_Connection then AI_Connection:Disconnect(); AI_Connection = nil end
end

local function SpawnClone()
    RemoveClone()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    char.Archivable = true
    local clone = char:Clone()
    clone.Name = "RealAI_Clone"
    
    for _, v in ipairs(clone:GetDescendants()) do
        if v:IsA("Script") or v:IsA("LocalScript") then
            if v.Name ~= "Animate" then v:Destroy() end
        end
    end

    local root = char.HumanoidRootPart
    clone:PivotTo(root.CFrame * CFrame.new(0, 0, 5))
    
    for _, part in ipairs(clone:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = false end
    end

    CloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
    CloneRoot = clone:FindFirstChild("HumanoidRootPart")
    CloneObj = clone

    if CloneHumanoid then
        CloneHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        CloneHumanoid.WalkSpeed = 20
    end

    local bill = Instance.new("BillboardGui")
    -- Aumentei o tamanho do balão e a distância para o texto não vazar
    bill.Size = UDim2.new(0, 250, 0, 80)
    bill.StudsOffset = Vector3.new(0, 3, 0)
    bill.AlwaysOnTop = true
    
    CloneChatText = Instance.new("TextLabel")
    CloneChatText.Size = UDim2.new(1, 0, 1, 0)
    CloneChatText.BackgroundTransparency = 0.3
    CloneChatText.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    CloneChatText.TextColor3 = Colors.Accent
    CloneChatText.TextScaled = true
    CloneChatText.TextWrapped = true -- Permite que o texto quebre linha
    CloneChatText.Font = Enum.Font.GothamBold
    CloneChatText.Text = "😎 Olá! Sou a IA Shadow oq pode ajudar?."
    CloneChatText.Parent = bill
    addCorner(CloneChatText, 8)
    
    local head = clone:FindFirstChild("Head")
    if head then bill.Parent = head end
    clone.Parent = Workspace

    AI_Connection = RunService.Heartbeat:Connect(function()
        if not CloneObj or not CloneObj.Parent or not CloneHumanoid or not CloneRoot then return end
        if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
        
        local myRoot = LocalPlayer.Character.HumanoidRootPart
        if (CloneRoot.Position - myRoot.Position).Magnitude > 6 then
            CloneHumanoid:MoveTo(myRoot.Position)
        else
            CloneHumanoid:MoveTo(CloneRoot.Position)
            CloneRoot.CFrame = CFrame.lookAt(CloneRoot.Position, myRoot.Position)
        end
    end)
end

-- ==========================================
-- INTEGRAÇÃO COM A IA REAL
-- ==========================================
local function GetRequestFunction()
    return (syn and syn.request) or (http and http.request) or http_request or request
end

local function AskAI(message)
    AddMessage(message, true)
    ChatInput.Text = ""
    
    if CloneChatText then CloneChatText.Text = "🤖 Pensando..." end

    if API_KEY == "COLE_SUA_CHAVE_AQUI" or #API_KEY < 10 then
        AddMessage("Erro: Coloque uma API KEY válida da Groq no script!", false)
        if CloneChatText then CloneChatText.Text = "❌ Falta a API Key." end
        return
    end

    local requestFunc = GetRequestFunction()
    if not requestFunc then
        AddMessage("Seu executor não suporta requisições HTTP (request).", false)
        if CloneChatText then CloneChatText.Text = "❌ Executor sem suporte." end
        return
    end

    local data = {
        model = MODELO, -- Usando o modelo GPT-OSS ativo
        messages = {
            { role = "system", content = "Você é um clone amigável dentro do jogo Roblox. Responda de forma completa, clara e em português. Não use emojis em excesso." },
            { role = "user", content = message }
        },
        max_tokens = 150,
        temperature = 0.7
    }

    local body = HttpService:JSONEncode(data)
    
    task.spawn(function()
        local success, response = pcall(function()
            return requestFunc({
                Url = "https://api.groq.com/openai/v1/chat/completions",
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json",
                    ["Authorization"] = "Bearer " .. API_KEY
                },
                Body = body
            })
        end)

        if success and response then
            if response.StatusCode == 200 then
                local decoded = HttpService:JSONDecode(response.Body)
                local reply = decoded.choices[1].message.content
                
                reply = reply:gsub("\n", " "):gsub("^%s*(.-)%s*$", "%1")
                
                -- 🔥 CORREÇÃO AQUI: Limite aumentado para 1000 caracteres
                if #reply > 1000 then 
                    reply = reply:sub(1, 1000) .. "..." 
                end
                
                AddMessage(reply, false)
                if CloneChatText then CloneChatText.Text = "💬 " .. reply end
            else
                AddMessage("Erro da API: Código " .. tostring(response.StatusCode), false)
                if CloneChatText then CloneChatText.Text = "❌ Erro " .. tostring(response.StatusCode) end
                
                if response.Body then
                    local errDecoded = HttpService:JSONDecode(response.Body)
                    if errDecoded.error and errDecoded.error.message then
                        AddMessage("Detalhe: " .. errDecoded.error.message, false)
                    end
                end
            end
        else
            AddMessage("Falha na conexão. Verifique sua internet ou executor.", false)
            if CloneChatText then CloneChatText.Text = "❌ Falha de rede." end
        end
    end)
end

