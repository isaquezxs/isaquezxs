local function ProcessarPacoteRemoto(nomeJogador, x, y, z, mensagem)
    if nomeJogador == LocalPlayer.Name then return end
    if not OutrosClones[nomeJogador] then
        local player = Players:FindFirstChild(nomeJogador)
        if not player or not player.Character then return end
        
        local clone = player.Character:Clone()
        clone.Name = "RemoteAI_" .. nomeJogador
        for _, v in ipairs(clone:GetDescendants()) do
            if v:IsA("Script") or v:IsA("LocalScript") then v:Destroy() end
            if v:IsA("BasePart") then v.CanCollide = false; v.Anchored = true end
        end
        
        local bill = Instance.new("BillboardGui")
        bill.Size = UDim2.new(0, 250, 0, 80)
        bill.StudsOffset = Vector3.new(0, 3, 0)
        bill.AlwaysOnTop = true
        
        local chatText = Instance.new("TextLabel")
        chatText.Name = "ChatText"
        chatText.Size = UDim2.new(1, 0, 1, 0)
        chatText.BackgroundTransparency = 0.3
        chatText.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
        chatText.TextColor3 = Colors.SyncColor
        chatText.TextScaled = true
        chatText.TextWrapped = true
        chatText.Font = Enum.Font.GothamBold
        chatText.Text = mensagem
        chatText.Parent = bill
        addCorner(chatText, 8)
        
        local head = clone:FindFirstChild("Head")
        if head then bill.Parent = head end
        
        clone.Parent = Workspace
        OutrosClones[nomeJogador] = {Objeto = clone, ChatText = chatText}
    end
    
    local data = OutrosClones[nomeJogador]
    if data and data.Objeto and data.Objeto.Parent then
        data.Objeto:PivotTo(CFrame.new(x, y, z))
        data.ChatText.Text = mensagem
    end
end

local function IniciarSync()
    if SyncLoop then SyncLoop:Disconnect() end
    
    -- Envia os dados para o chat de forma criptografada
    SyncLoop = task.spawn(function()
        while SyncEnabled do
            if CloneObj and CloneRoot and LocalPlayer.Character then
                local pos = CloneRoot.Position
                local msg = UltimaMensagemIA:gsub("~", ""):gsub("\n", " ")
                
                -- Criptografa as coordenadas
                local encX = Encode(math.floor(pos.X))
                local encY = Encode(math.floor(pos.Y))
                local encZ = Encode(math.floor(pos.Z))
                
                -- Formato: [AI]~Nome~X~Y~Z~Mensagem
                local pacote = string.format("[AI]~%s~%s~%s~%s~%s", LocalPlayer.Name, encX, encY, encZ, msg)
                
                pcall(function()
                    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                        TextChatService.ChatChannels:FindFirstChild("RBXGeneral"):SendAsync(pacote)
                    else
                        game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.SayMessageRequest:FireServer(pacote, "All")
                    end
                end)
            end
            task.wait(0.3) -- Envia a cada 0.3 segundos para não tomar mute
        end
    end)

    -- Recebe as mensagens do chat
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        TextChatService.OnIncomingMessage = function(message)
            local text = message.Text
            if string.sub(text, 1, 4) == "[AI]~" then
                local partes = string.split(text, "~")
                if #partes >= 6 then
                    local nome = partes[2]
                    local encX = partes[3]
                    local encY = partes[4]
                    local encZ = partes[5]
                    local fala = partes[6]
                    
                    -- Descriptografa
                    local x = tonumber(Decode(encX)) or 0
                    local y = tonumber(Decode(encY)) or 0
                    local z = tonumber(Decode(encZ)) or 0
                    
                    ProcessarPacoteRemoto(nome, x, y, z, fala)
                end
                local properties = Instance.new("TextChatMessageProperties")
                properties.Text = "" -- Esconde a mensagem
                return properties
            end
        end
    end
end

local function soltarClone()
    if CarryWeld then CarryWeld:Destroy() CarryWeld = nil end
    isCarrying = false
    modoCarregar = nil
    if CloneHumanoid then
        CloneHumanoid.PlatformStand = false
        CloneHumanoid.AutoRotate = true
    end
    if CloneRoot and LocalPlayer.Character then
        local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            CloneRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, 15) 
            task.wait(0.1)
            if CloneHumanoid then CloneHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
        end
    end
    CarryMenu.Visible = false
end

local function pegarClone(modo)
    local myChar = LocalPlayer.Character
    if not myChar or not CloneObj then return end
    local myTorso = myChar:FindFirstChild("UpperTorso") or myChar:FindFirstChild("Torso")
    if not myTorso then return end

    if isCarrying and modoCarregar == modo then soltarClone() return end
    if CarryWeld then CarryWeld:Destroy() end

    isCarrying = true
    modoCarregar = modo
    CloneHumanoid.PlatformStand = true
    CloneHumanoid.AutoRotate = false
    CarryMenu.Visible = false

    for _, p in ipairs(CloneObj:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false p.Massless = true end
    end

    CarryWeld = Instance.new("Weld")
    CarryWeld.Part0 = myTorso
    CarryWeld.Part1 = CloneRoot
    CarryWeld.Parent = myTorso

    if modo == "Ombros" then
        CloneRoot.CFrame = myChar.HumanoidRootPart.CFrame * CFrame.new(0, 2.5, 0.2)
        CarryWeld.C0 = CFrame.new(0, 1.8, 0.2)
        CarryWeld.C1 = CFrame.new(0, -0.5, 0)
    elseif modo == "Machucado" then
        CloneRoot.CFrame = myChar.HumanoidRootPart.CFrame * CFrame.new(0, 0.5, -1.8)
        CarryWeld.C0 = CFrame.new(0, 0.2, -1.6) * CFrame.Angles(math.rad(90), 0, math.rad(90))
        CarryWeld.C1 = CFrame.new(0, 0, 0)
    elseif modo == "Costas" then
        CloneRoot.CFrame = myChar.HumanoidRootPart.CFrame * CFrame.new(0, 1.8, 1.6)
        CarryWeld.C0 = CFrame.new(0, 1.0, 1.6)
        CarryWeld.C1 = CFrame.new(0, 0, 0)
    end
end

