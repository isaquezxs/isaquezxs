local function soltarClone()
    if CarryWeld then CarryWeld:Destroy() CarryWeld = nil end
    isCarrying = false
    modoCarregar = nil
    if CloneHumanoid then
        CloneHumanoid.PlatformStand = false
        CloneHumanoid.AutoRotate = true
    end
    if CloneRoot and LocalPlayer.Character then
        local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            CloneRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, 15) 
            task.wait(0.1)
            if CloneHumanoid then CloneHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
        end
    end
    CarryMenu.Visible = false
end

local function pegarClone(modo)
    local myChar = LocalPlayer.Character
    if not myChar or not CloneObj then return end
    local myTorso = myChar:FindFirstChild("UpperTorso") or myChar:FindFirstChild("Torso")
    if not myTorso then return end

    if isCarrying and modoCarregar == modo then soltarClone() return end
    if CarryWeld then CarryWeld:Destroy() end

    isCarrying = true
    modoCarregar = modo
    CloneHumanoid.PlatformStand = true
    CloneHumanoid.AutoRotate = false
    CarryMenu.Visible = false

    for _, p in ipairs(CloneObj:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false p.Massless = true end
    end

    CarryWeld = Instance.new("Weld")
    CarryWeld.Part0 = myTorso
    CarryWeld.Part1 = CloneRoot
    CarryWeld.Parent = myTorso

    if modo == "Ombros" then
        CloneRoot.CFrame = myChar.HumanoidRootPart.CFrame * CFrame.new(0, 2.5, 0.2)
        CarryWeld.C0 = CFrame.new(0, 1.8, 0.2)
        CarryWeld.C1 = CFrame.new(0, -0.5, 0)
    elseif modo == "Machucado" then
        CloneRoot.CFrame = myChar.HumanoidRootPart.CFrame * CFrame.new(0, 0.5, -1.8)
        CarryWeld.C0 = CFrame.new(0, 0.2, -1.6) * CFrame.Angles(math.rad(90), 0, math.rad(90))
        CarryWeld.C1 = CFrame.new(0, 0, 0)
    elseif modo == "Costas" then
        CloneRoot.CFrame = myChar.HumanoidRootPart.CFrame * CFrame.new(0, 1.8, 1.6)
        CarryWeld.C0 = CFrame.new(0, 1.0, 1.6)
        CarryWeld.C1 = CFrame.new(0, 0, 0)
    end
end

