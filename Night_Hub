local function RemoveClone()
    if CarryWeld then CarryWeld:Destroy() CarryWeld = nil end
    if CloneObj then CloneObj:Destroy() CloneObj = nil end
    if AI_Connection then AI_Connection:Disconnect() AI_Connection = nil end
    isCarrying = false
    seguindo = false
    tracksDoClone = {}
    CarryMenu.Visible = false
end

local function SpawnClone()
    RemoveClone()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    char.Archivable = true
    local clone = char:Clone()
    if not clone then return end
    
    clone.Name = "RealAI_Clone"

    for _, part in ipairs(clone:GetDescendants()) do
        if part:IsA("Script") or part:IsA("LocalScript") then
            if part.Name ~= "Animate" then part:Destroy() end
        end
        if part:IsA("BasePart") then part.CanCollide = false end
    end

    CloneHumanoid = clone:FindFirstChildOfClass("Humanoid")
    CloneRoot = clone:FindFirstChild("HumanoidRootPart")
    CloneObj = clone

    if CloneHumanoid then
        CloneHumanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        CloneHumanoid.WalkSpeed = 18 
        CloneHumanoid.AutoRotate = true
        CloneHumanoid.PlatformStand = false
    end

    -- Sistema de Animação
    local meuHumanoid = char:FindFirstChildOfClass("Humanoid")
    local meuAnimator = meuHumanoid and meuHumanoid:FindFirstChildOfClass("Animator")
    local cloneAnimator = CloneHumanoid:FindFirstChildOfClass("Animator")
    if not cloneAnimator then
        cloneAnimator = Instance.new("Animator")
        cloneAnimator.Parent = CloneHumanoid
    end

    local function copiarAnimacao(animId)
        if tracksDoClone[animId] then return tracksDoClone[animId] end
        local anim = Instance.new("Animation")
        anim.AnimationId = animId
        local track = cloneAnimator:LoadAnimation(anim)
        track.Priority = Enum.AnimationPriority.Action
        track.Looped = true
        tracksDoClone[animId] = track
        return track
    end

    if meuAnimator then
        meuAnimator.AnimationPlayed:Connect(function(track)
            if not CloneObj or not CloneObj.Parent then return end
            if not track or not track.Animation then return end
            local novo = copiarAnimacao(track.Animation.AnimationId)
            novo:Play(0.1)
            novo:AdjustSpeed(track.Speed)
            track.Stopped:Connect(function()
                if novo.IsPlaying then novo:Stop(0.1) end
            end)
        end)
        for _, track in pairs(meuAnimator:GetPlayingAnimationTracks()) do
            if track and track.Animation then
                local novo = copiarAnimacao(track.Animation.AnimationId)
                novo:Play(0.1)
            end
        end
    end

    local bill = Instance.new("BillboardGui")
    bill.Size = UDim2.new(0, 250, 0, 80)
    bill.StudsOffset = Vector3.new(0, 3, 0)
    bill.AlwaysOnTop = true
    CloneChatText = Instance.new("TextLabel")
    CloneChatText.Size = UDim2.new(1, 0, 1, 0)
    CloneChatText.BackgroundTransparency = 0.3
    CloneChatText.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    CloneChatText.TextColor3 = Colors.Accent
    CloneChatText.TextScaled = true
    CloneChatText.TextWrapped = true
    CloneChatText.Font = Enum.Font.GothamBold
    CloneChatText.Text = "😎 Olá! Sou a IA Shadow."
    CloneChatText.Parent = bill
    addCorner(CloneChatText, 8)
    
    local head = clone:FindFirstChild("Head")
    if head then bill.Parent = head end

    local click = Instance.new("ClickDetector")
    click.MaxActivationDistance = 20
    click.Parent = CloneRoot
    click.MouseClick:Connect(function()
        if isCarrying then
            soltarClone()
        else
            CarryMenu.Visible = not CarryMenu.Visible
        end
    end)

    clone:PivotTo(char.HumanoidRootPart.CFrame * CFrame.new(0, 0, 15))
    clone.Parent = Workspace

    -- Loop de Seguir
    AI_Connection = RunService.Heartbeat:Connect(function()
        if not CloneObj or not CloneObj.Parent then return end
        if not LocalPlayer.Character then return end
        
        local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local myHumanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        
        if not myRoot or not myHumanoid then return end 
        if isCarrying then return end

        local distance = (CloneRoot.Position - myRoot.Position).Magnitude
        CloneHumanoid.WalkSpeed = myHumanoid.WalkSpeed + 4

        if distance > 50 then
            CloneRoot.CFrame = myRoot.CFrame * CFrame.new(0, 0, 15)
            seguindo = false
            return
        end

        if distance > 12 then 
            seguindo = true 
        elseif distance < 8 then 
            seguindo = false 
        end

        if seguindo then
            if tick() - lastMove > 0.1 then 
                lastMove = tick()
                CloneHumanoid:MoveTo(myRoot.Position)
            end
        else
            CloneHumanoid:MoveTo(CloneRoot.Position)
        end

        local myState = myHumanoid:GetState()
        local cloneState = CloneHumanoid:GetState()
        if myState == Enum.HumanoidStateType.Jumping or myState == Enum.HumanoidStateType.Freefall then
            if cloneState == Enum.HumanoidStateType.Running or cloneState == Enum.HumanoidStateType.Landed then
                CloneHumanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end)
end

-- ===== IA =====
local isThinking = false
local function GetRequestFunction()
    return (syn and syn.request) or (http and http.request) or http_request or request
end

local function AskAI(message)
    if isThinking then return end
    AddMessage(message, true)
    ChatInput.Text = ""
    if CloneChatText then CloneChatText.Text = "🤖 Pensando..." end
    
    if API_KEY == "" or #API_KEY < 10 then
        AddMessage("Erro: Coloque uma API KEY válida!", false)
        return
    end
    
    local requestFunc = GetRequestFunction()
    if not requestFunc then AddMessage("Executor sem request.", false) return end
    
    isThinking = true
    SendBtn.Text = "..."
    local data = {
        model = MODELO,
        messages = {
            { role = "system", content = "Você é um clone amigável no Roblox. Responda de forma curta, completa, clara e em português." },
            { role = "user", content = message }
        },
        max_tokens = 300,
        temperature = 0.7
    }
    local body = HttpService:JSONEncode(data)
    
    task.spawn(function()
        local success, response = pcall(function()
            return requestFunc({
                Url = "https://api.groq.com/openai/v1/chat/completions",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json", ["Authorization"] = "Bearer " .. API_KEY },
                Body = body
            })
        end)
        isThinking = false
        SendBtn.Text = "Enviar"
        if success and response and response.StatusCode == 200 then
            local decoded = HttpService:JSONDecode(response.Body)
            local reply = decoded.choices[1].message.content
            reply = reply:gsub("\n", " "):gsub("^%s*(.-)%s*$", "%1")
            
            if #reply > 1000 then 
                reply = reply:sub(1, 1000) .. "..." 
            end
            
            AddMessage(reply, false)
            if CloneChatText then CloneChatText.Text = "💬 " .. reply end
        else
            AddMessage("Erro da API: Verifique sua chave ou internet.", false)
        end
    end)
end

SendBtn.MouseButton1Click:Connect(function()
    if ChatInput.Text ~= "" then AskAI(ChatInput.Text) end
end)
ChatInput.FocusLost:Connect(function(enter)
    if enter and ChatInput.Text ~= "" then AskAI(ChatInput.Text) end
end)

